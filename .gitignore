# Dependencies
backend/vendor/
frontend/node_modules/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/auth.json

# Laravel runtime/cache output
backend/bootstrap/cache/*.php
backend/storage/*.key
backend/storage/app/public/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/storage/pail/
backend/.phpunit.cache/
backend/.phpunit.result.cache
backend/database/*.sqlite
backend/database/*.sqlite-*

# Keep Laravel placeholder files in otherwise ignored runtime folders
!backend/bootstrap/cache/.gitignore
!backend/storage/app/public/.gitignore
!backend/storage/framework/cache/data/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/testing/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore
!backend/database/.gitignore

# Nuxt/Vite runtime and build output
frontend/.cache/
frontend/.data/
frontend/.nitro/
frontend/.nuxt/
frontend/.output/
frontend/dist/
frontend/coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor/local tooling
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
.zed/
.cursor/
.codex/

*.pdf
*.xlsx
!Checklista SBA.pdf
!Checklista SBA.xlsx
# Git and editor state
.git
.gitignore
.DS_Store
.idea
.vscode
.cursor

# Environment/secrets
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies and generated output
backend/vendor
frontend/node_modules
frontend/.nuxt
frontend/.output
frontend/.nitro
frontend/dist
frontend/coverage

# Runtime/test data
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
backend/database/*.sqlite
backend/database/*.sqlite-*

# Local docs/reference exports that are not needed in images
/tmp
*.log

# Docker image source
GHCR_OWNER=OWNER
IMAGE_TAG=latest

# Public domain handled by Caddy. DNS must point this hostname to the server.
APP_DOMAIN=sba.example.se
CADDY_EMAIL=admin@example.se

# Laravel application
APP_NAME=SBA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://sba.example.se
FRONTEND_URL=https://sba.example.se
LOG_LEVEL=warning

# Database
DB_DATABASE=sba
DB_USERNAME=sba
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Redis/cache/session/queue
REDIS_HOST=redis
CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Mail. Keep log until real SMTP is configured.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@example.se
# MAIL_FROM_NAME="SBA"

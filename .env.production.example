# Docker image source
GHCR_OWNER=OWNER
IMAGE_TAG=latest

# Public production URLs on the VPS central Caddy
APP_URL=https://sba-api.mosnet.cyou
FRONTEND_URL=https://sba-app.mosnet.cyou
NUXT_PUBLIC_API_BASE=https://sba-api.mosnet.cyou/api

# Laravel application
APP_NAME=SBA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
LOG_LEVEL=warning

# Database
DB_DATABASE=sba
DB_USERNAME=sba
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Redis/cache/session/queue
REDIS_HOST=redis
CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
SESSION_DOMAIN=.mosnet.cyou
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# CORS. Current app has no credentialed login flow; keep credentials false.
CORS_ALLOWED_ORIGINS=https://sba-app.mosnet.cyou
CORS_SUPPORTS_CREDENTIALS=false

# Future Sanctum/session auth note: if Sanctum is added later, also configure
# SANCTUM_STATEFUL_DOMAINS=sba-app.mosnet.cyou
# and switch CORS_SUPPORTS_CREDENTIALS=true with frontend credentialed requests.

# Mail. Keep log until real SMTP is configured.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@mosnet.cyou
# MAIL_FROM_NAME="SBA"
